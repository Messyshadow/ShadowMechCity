# Godot 4+ specific ignores
.godot/
/android/
.nomedia

# 截图/录制工具产出 (godot-capture)
/screenshots/
/_shot.png
/_shot_*.png

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Rebuilt executables and transient remaster QA output.
/build/
/remaster/qa/*
!/remaster/qa/.gdignore
!/remaster/qa/REPORT.md
!/remaster/qa/RELEASE_2026-09-18.md
!/remaster/qa/REVISION_0_2_0.md
!/remaster/qa/RELEASE_0_2_0.md
!/remaster/qa/published_0_2_0.log
!/remaster/qa/published_0_2_0_errors.log
!/remaster/qa/published_0_2_0.png
!/remaster/qa/EXPERIENCE_0_3_0.md
!/remaster/qa/RELEASE_0_3_0.md
!/remaster/qa/experience_test_*.log
!/remaster/qa/experience_visual*.log
!/remaster/qa/experience_*.png
!/remaster/qa/published_0_3_0*
!/remaster/qa/revision_tests.log
!/remaster/qa/revision_combat_tests.log
!/remaster/qa/revision_extended_tests.log
!/remaster/qa/revision_visual.log
!/remaster/qa/revision_visual_errors.log
!/remaster/qa/revision_*.png
!/remaster/qa/release_qa_tests.log
!/remaster/qa/release_combat_tests.log
!/remaster/qa/published_smoke.log
!/remaster/qa/published_hub.png
!/remaster/qa/*_final.png
!/remaster/qa/final_tests.log
!/remaster/qa/release_visual.log
/remaster/source/*.blend1
/remaster/source/__pycache__/

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json
/_qc_*.png
/_hero_zoom.png
/_s_*.png
*.tmp
