!/remaster/qa/revision_combat_tests.log
!/remaster/qa/revision_extended_tests.log
!/remaster/qa/revision_visual.log
!/remaster/qa/revision_visual_errors.log
!/remaster/qa/revision_*.png
!/remaster/qa/release_qa_tests.log
!/remaster/qa/release_combat_tests.log
!/remaster/qa/published_smoke.log
!/remaster/qa/published_hub.png
!/remaster/qa/*_final.png
!/remaster/qa/final_tests.log
!/remaster/qa/release_visual.log
/remaster/source/*.blend1
/remaster/source/__pycache__/
!/remaster/qa/RELEASE_0_5_0.md
!/remaster/qa/arsenal_test_*.log
!/remaster/qa/arsenal_visual*.log
!/remaster/qa/arsenal_*.png
!/remaster/qa/published_0_5_0*

# Imported translations (automatically generated from CSV files)
*.translation

