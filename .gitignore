# Godot 4+ specific ignores
.godot/
/android/
.nomedia

# 截图/录制工具产出 (godot-capture)
/screenshots/
/_shot.png
/_shot_*.png

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Rebuilt executables and transient remaster QA output.
/build/
/remaster/qa/*
!/remaster/qa/.gdignore
!/remaster/qa/REPORT.md
!/remaster/qa/RELEASE_2026-09-18.md
!/remaster/qa/REVISION_0_2_0.md
!/remaster/qa/RELEASE_0_2_0.md
!/remaster/qa/published_0_2_0.log
!/remaster/qa/published_0_2_0_errors.log
!/remaster/qa/published_0_2_0.png
