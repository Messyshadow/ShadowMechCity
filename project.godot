; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="暗影机械城 · 重铸余烬"
config/version="0.6.0"
config/description="3D 横版动作重制开发版：重铸余烬。八个区域、40 个房间、三大技能分页与七位核心守卫。"
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/暗影机械城 - 横版动作Demo"
run/main_scene="res://remaster/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/game.gd"
Reforged="*res://remaster/state.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

joypads/ignore_joypad_on_unfocused_application=true

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="hitbox"
2d_physics/layer_5="pickup"

[physics]

3d/physics_engine="Jolt Physics"
